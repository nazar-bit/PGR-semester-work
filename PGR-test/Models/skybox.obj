mtllib skybox.mtl

# Vertices
v  1.0 -1.0 -1.0
v  1.0 -1.0  1.0
v -1.0 -1.0  1.0
v -1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0
v -1.0  1.0 -1.0

# UV Coordinates
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Faces (Strictly CCW from inside)

# Front (-Z)
usemtl mat_nz
f 4/1 1/2 5/3
f 4/1 5/3 8/4

# Right (+X)
usemtl mat_px
f 1/1 2/2 6/3
f 1/1 6/3 5/4

# Back (+Z)
usemtl mat_pz
f 2/1 3/2 7/3
f 2/1 7/3 6/4

# Left (-X)
usemtl mat_nx
f 3/1 4/2 8/3
f 3/1 8/3 7/4

# Top (+Y)
usemtl mat_py
f 5/1 6/2 7/3
f 5/1 7/3 8/4

# Bottom (-Y)
usemtl mat_ny
f 4/1 3/2 2/3
f 4/1 2/3 1/4

# End of file padding to prevent EOF parser drops